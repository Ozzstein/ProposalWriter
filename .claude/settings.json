{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "python hooks/check_dedupe.py"}]
      },
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "python hooks/check_depth.py"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "python hooks/validate_output.py"}]
      },
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "python hooks/check_citations.py"}]
      }
    ]
  },
  "mcpServers": {
    "academic-search": {
      "command": "python3",
      "args": ["mcp-servers/academic-search/server.py"],
      "env": {
        "ELSEVIER_API_KEY": "REDACTED"
      }
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "REDACTED",
        "PATH": "/opt/homebrew/opt/node@23/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  }
}
